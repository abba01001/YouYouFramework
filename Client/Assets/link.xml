<linker>
  <assembly fullname="UnityEngine.Physics2DModule">
    <type fullname="UnityEngine.PolygonCollider2D" preserve="all" />
    <type fullname="UnityEngine.CapsuleCollider2D" preserve="all" />
  </assembly>
  
  <assembly fullname="UnityEngine.SpriteMaskModule">
    <type fullname="UnityEngine.SpriteMask" preserve="all" />
  </assembly>

  <assembly fullname="YooAsset">
    <!-- 手动添加这一行，保住它的构造函数 -->
    <type fullname="YooAsset.DefaultWebServerFileSystem" preserve="all" />
  </assembly>

  <assembly fullname="UnityEngine.CoreModule" preserve="all">
    <type fullname="UnityEngine.Shader" preserve="all" />
    <type fullname="UnityEngine.Material" preserve="all" />
  </assembly>

  <assembly fullname="UnityEngine.Android">
    <type fullname="UnityEngine.Android.Permission" preserve="all"/>
  </assembly>

  <assembly fullname="Unity.Notifications.Android">
    <type fullname="Unity.Notifications.Android.AndroidNotificationChannel" preserve="all"/>
    <type fullname="Unity.Notifications.Android.AndroidNotification" preserve="all"/>
    <type fullname="Unity.Notifications.Android.AndroidNotificationCenter" preserve="all"/>
  </assembly>
</linker>